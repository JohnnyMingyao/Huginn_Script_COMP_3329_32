  imageDisplay: {fileID: 660652807}
  textDisplay: {fileID: 660652806}
  imageGroup: {fileID: 660652805}
  textGroup: {fileID: 660652804}
  slides:
  - image: {fileID: 21300000, guid: 73ab36dd350ca4f558df4a6a5c6a287c, type: 3}
    text: "Huginn: \u201CThe scientists found no signals. But I found a disk.\u201D"
  - image: {fileID: 21300000, guid: ba005b33f9fbd4729bdc7dac048d7b4e, type: 3}
    text: "Weeby suddenly sits upright: \u201CHah! I knew they were hiding something!\u201D"
  - image: {fileID: 21300000, guid: 15d7a9520968249c5ad808fc565a15ba, type: 3}
    text: "Huginn: \u201CIt\u2019s old. Alien maybe. Not working.\u201D"
  - image: {fileID: 21300000, guid: 6a04342a7959445539bfad177056a6e7, type: 3}
    text: "Weeby: \u201CThey\u2019re there to keep us stupid. But I see through it.
      We see through it.\u201D"
  - image: {fileID: 21300000, guid: ba005b33f9fbd4729bdc7dac048d7b4e, type: 3}
    text: "Weeby, whispering to the disk: \u201CYou won\u2019t fool me. Not anymore.\u201D"
  fadeDuration: 0.1
  nextSceneName: stage 3
